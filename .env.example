# SQLite database path.
# Use an ABSOLUTE path: web, mcp-server, and db run from different cwds under
# turbo, so a relative path resolves to three separate DB files. The relative
# default below works for single-package commands; set an absolute path for `pnpm dev`.
SQLITE_DB_PATH=./data/tasks.db

# MCP Server (generate a key with: openssl rand -hex 32)
MCP_API_KEY=
MCP_PORT=3100

# Web App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extension registration (optional — connects to Baker Street platform)
# NATS_URL=nats://nats.bakerst.svc.cluster.local:4222
# EXTENSION_MCP_URL=http://ext-baker-street-tasks.bakerst.svc.cluster.local:8080/mcp
